{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // The Worker has its own tsconfig: its globals come from
  // @cloudflare/workers-types, which collides with the lib set here.
  // `server/scripts` stays in, because the seed parity test imports the
  // generator.
  "exclude": ["server/src", "server/node_modules"]
}
