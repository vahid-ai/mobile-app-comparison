{
  "name": "pulse-events-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:schema": "wrangler d1 execute pulse-events --remote --file=schema.sql",
    "db:seed": "wrangler d1 execute pulse-events --remote --file=seed.sql",
    "db:schema:local": "wrangler d1 execute pulse-events --local --file=schema.sql",
    "db:seed:local": "wrangler d1 execute pulse-events --local --file=seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.28.0"
  }
}
