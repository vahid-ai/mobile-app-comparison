{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    // A development build — the fallback when Expo Go cannot load an
    // update (see README, "Getting it onto a phone"). Install this once and
    // every subsequent `eas update` lands in it over the air.
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      // Internal distribution already yields an APK on Android; stating it
      // means the CI job that attaches the artifact to a GitHub release can
      // rely on the extension rather than hope for it.
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
